{
  "appId": "com.happynatsu.happygenstudio",
  "appName": "HappyGen Studio",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": true,
    "captureInput": true
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Media": {
      "androidGalleryMode": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_happygen",
      "iconColor": "#6366F1"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com", "twitter.com"]
    }
  }
}
