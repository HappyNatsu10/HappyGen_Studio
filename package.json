{
  "name": "happygen-studio",
  "version": "2.0.0",
  "description": "HappyGen Studio — Premium AI image generation workstation with live CivitAI model explorer",
  "author": "HappyNatsu",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server:models": "python scripts/local_inference_server.py",
    "electron:dev": "vite build && electron .",
    "electron:start": "electron .",
    "build:win": "vite build && electron-builder --win nsis",
    "build:win-portable": "vite build && electron-builder --win portable",
    "build:mac": "vite build && electron-builder --mac dmg",
    "build:linux": "vite build && electron-builder --linux AppImage",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "build:android": "vite build && npx cap sync android",
    "build:ios": "vite build && npx cap sync ios"
  },
  "build": {
    "appId": "com.happynatsu.happygenstudio",
    "productName": "HappyGen Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/core": "^7.0.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.10",
    "gsap": "^3.15.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "@tailwindcss/postcss": "^4.0.5",
    "@tailwindcss/vite": "^4.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.5",
    "vite": "^6.1.0"
  }
}
